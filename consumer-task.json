
{
    "family": "eventgateway-consumer", 
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::871640285396:role/eventgateway-execution-role",
    "taskRoleArn": "arn:aws:iam::871640285396:role/eventgateway-task-role",
    "containerDefinitions": [
        {
            "name": "consumer",
            "image": "871640285396.dkr.ecr.us-east-1.amazonaws.com/eventgateway-worker:latest",
            "environment": [
                {"name": "SQS_QUEUE_URL", "value":"https://sqs.us-east-1.amazonaws.com/871640285396/event-gateway-queue"},
                {"name": "DATABASE_URL", "value":"postgresql://sujaladhikari:Test12345@database-1.cwv68ociang2.us-east-1.rds.amazonaws.com:5432/database-1"}
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/eventgateway-consumer",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
