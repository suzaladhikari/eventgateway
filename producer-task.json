
{
    "family": "eventgateway-producer", 
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::871640285396:role/eventgateway-execution-role",
    "taskRoleArn": "arn:aws:iam::871640285396:role/eventgateway-task-role",
    "containerDefinitions": [
        {
            "name": "producer",
            "image": "871640285396.dkr.ecr.us-east-1.amazonaws.com/eventgateway-producer:latest",
            "portMappings": [
                {"containerPort": 8000, "protocol": "tcp"}
            ],
            "environment": [
                {"name": "SQS_QUEUE_URL", "value":"https://sqs.us-east-1.amazonaws.com/871640285396/event-gateway-queue"}
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/eventgateway-producer",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}